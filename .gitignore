__pycache__/
*.py[cod]
.venv/
venv/
.DS_Store

# tool caches
.pytest_cache/
.ruff_cache/

# run artifacts
runs/
wandb/
checkpoints*/
media/

# keep the dir: slurm resolves `#SBATCH -o logs/...` before the job runs, so it
# must already exist on a fresh clone
logs/*
!logs/.gitkeep

# model weights / adapters
*.pt
*.bin
*.safetensors

# regenerable from HF: python src/benchmarks.py --name <set>
data/bench_*.jsonl
data/zpd_stub.jsonl

# TEA COPYRIGHT - MUST NOT BE COMMITTED. Released STAAR PDFs and everything
# extracted from them: "Reproduction of all or portions of this work is
# prohibited without express written permission from the Texas Education
# Agency." This repo is public. The extractor is ours and is committed; the
# test content is not. Rebuild with `python src/staar_extract.py --download`.
data/staar/

# Same for every other state: released items are state-copyright and this repo
# is public. Pennsylvania, for instance, permits duplication "by Pennsylvania
# educators for local classroom use" only. Extractors are committed, content is
# not. Belt and braces - the extractor is also expected to add this.
data/state_tests/

.gitignore
# the labelling bundle is built from state-assessment traces (state copyright);
# rebuild with: python src/build_label_set.py
label_app/data/
label_app/.firebase/

# Same reason: these carry the question and answer text inline, so they fall
# under the same copyright as the PDFs that were deleted. The RATINGS are ours
# and are committed - data/labels_all.json, data/agent_labels.json,
# data/label_slices/ - keyed by turn id, and these rejoin them to the items:
#   python src/build_rm_data.py
data/rm_dataset.json
data/rm_agent.json
data/rm_human.json
data/leak_calibration.json
data/rm_embeddings.pt
