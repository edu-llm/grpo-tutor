__pycache__/
*.py[cod]
.venv/
venv/
.DS_Store

# run artifacts
runs/
wandb/
checkpoints*/

# keep the dir: slurm resolves `#SBATCH -o logs/...` before the job runs, so it
# must already exist on a fresh clone
logs/*
!logs/.gitkeep

# model weights / adapters
*.pt
*.bin
*.safetensors

# raw personal chat history scraped for style; the synthetic file replaces it
data/my_inputs.txt
data/my_inputs.jsonl

# regenerable from HF: python src/benchmarks.py --name <set>
data/bench_*.jsonl
